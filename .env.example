# EcoSat Monitor Environment Configuration

# Application
DEBUG=False
APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql://ecosat:ecosat@localhost:5432/ecosat
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0

# Google Earth Engine
# Follow GEE setup instructions in README to obtain these
GEE_PROJECT_ID=your-gee-project-id
GEE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json

# NASA EarthData
# Register at https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USER=your-earthdata-username
NASA_EARTHDATA_PASS=your-earthdata-password

# Copernicus Data Space
# Register at https://dataspace.copernicus.eu/
COPERNICUS_DSM_USER=your-copernicus-username
COPERNICUS_DSM_PASS=your-copernicus-password

# Tile Server
TILE_STORAGE_PATH=/data/tiles
TITILER_URL=http://localhost:8008

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Frontend
VITE_API_BASE_URL=http://localhost:8000
